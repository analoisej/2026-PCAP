#Objetivo: calcular e mostrar o valor que deve ser pago de imposto de renda
#---ANALISE(LIAC)---
#Entrada: um valor, com duas casas decimais 
#Saida: imprimir o testo "R$" seguido de um espaço e do valor total devido de imposto de Renda
salario = float(input())
imposto = 0.0 
if salario <= 2000.00:
    print("Inseto")
else:
    if salario <= 3000.00:
        imposto = (salario - 2000.00) * 0.08
    elif salario <= 4500.00:
        imposto = (1000.00 * 0.08) + ((salario - 3000.00) * 0.18)
    else:
        imposto = (1000.00 * 0.08) + (1500.00 * 0.18) + ((salario - 4500.00) * 0.28)
    print(f"R$ {imposto:.2f}")
    